{
  "name": "tiktok-live-interactive",
  "version": "1.0.0",
  "description": "TikTok Live Interactive - Controle de lives com presentes",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "dependencies": {
    "tiktok-live-connector": "^2.1.0"
  },
  "devDependencies": {
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "electron-packager": "^17.1.2",
    "serve": "^14.2.6"
  },
  "build": {
    "appId": "com.tiktok.live.interactive",
    "productName": "TikTok Live Interactive",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "TikTok-Live-Interactive.exe"
    },
    "files": [
      "main.js",
      "renderer/**/*",
      "node_modules/**/*",
      "!node_modules/electron/**",
      "!node_modules/electron-builder/**",
      "!node_modules/serve/**"
    ]
  }
}
